POSTGRES_USER=ticket_user
POSTGRES_PASSWORD=ticket_password_placeholder
POSTGRES_DB=ticket_db
DATABASE_URL=postgresql+psycopg://ticket_user:ticket_password_placeholder@postgres:5432/ticket_db

# Offline deterministic mode is the safe default.
AI_PROVIDER=deterministic
AI_MODEL=replace_with_provider_model
AI_API_KEY=replace_with_provider_api_key
# Leave empty to use the official client default endpoint.
AI_BASE_URL=
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_MAX_REPAIRS=1
AI_MAX_INPUT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=800
AI_FALLBACK_ENABLED=true
AI_DAILY_REQUEST_LIMIT=100
AI_MAX_CONCURRENT_REQUESTS=4
AI_PROMPT_VERSION=ticket-analysis-v1
